# Backend
PORT=5000
MONGODB_URI=mongodb://localhost:27017/leira
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=change-me

# Media — local dev
USE_S3_MEDIA=false
AWS_REGION=ap-south-1
AWS_S3_BUCKET=leiraindia-media-prod
AWS_CLOUDFRONT_URL=https://media.leiraindia.com

# Production EC2: USE_S3_MEDIA=true (+ IAM role or AWS keys)

# WhatsApp Business API (Connector / Graph-compatible)
# Auth header: api-key
WHATSAPP_ENABLED=true
WHATSAPP_BASE_URL=https://adminapis.backendprod.com/chat_and_campaign/whatsapp_graph/api/<ACCOUNT_ID>/<LABEL>/v19.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_API_KEY=
# --- Order WhatsApp (LMS template: order_management_4) ---
# Hi {{1}}, order placed... order number is {{2}}.
WHATSAPP_ORDER_TEMPLATE_ENABLED=true
WHATSAPP_ORDER_TEMPLATE_URL=https://adminapis.backendprod.com/lms_campaign/api/whatsapp/template/2s1ez7tkp8/process
WHATSAPP_ORDER_TEMPLATE_NAME=order_management_4
# Optional override; defaults to WHATSAPP_API_KEY
# WHATSAPP_ORDER_TEMPLATE_API_KEY=
WHATSAPP_ORDER_RECEIVER_FORMAT=e164

# Shipped / pickup-ready WhatsApp (LMS: order_pick_up_no_cta_4)
# Hello {{1}}, order {{2}} ready for pickup at {{3}}.
WHATSAPP_SHIPPED_TEMPLATE_ENABLED=true
WHATSAPP_SHIPPED_TEMPLATE_URL=https://adminapis.backendprod.com/lms_campaign/api/whatsapp/template/kzfg705by9/process
WHATSAPP_SHIPPED_TEMPLATE_NAME=order_pick_up_no_cta_4
WHATSAPP_SHIPPED_PICKUP_LOCATION=Leira pickup point
WHATSAPP_SHIPPED_RECEIVER_FORMAT=e164

# Delivered WhatsApp (LMS: order_delivered_0001)
# Hi {{1}}, Your {{2}} has been delivered. Thank you...
WHATSAPP_DELIVERED_TEMPLATE_ENABLED=true
WHATSAPP_DELIVERED_TEMPLATE_URL=https://adminapis.backendprod.com/lms_campaign/api/whatsapp/template/0uv3omy1e7/process
WHATSAPP_DELIVERED_TEMPLATE_NAME=order_delivered_0001
# {{2}} becomes "order LR-xxx" — set empty to send only order number
WHATSAPP_DELIVERED_ORDER_LABEL_PREFIX=order
WHATSAPP_DELIVERED_RECEIVER_FORMAT=e164

WHATSAPP_TIMEOUT_MS=20000
# Optional inbound webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_AUTO_MARK_READ=true

# Account creation WhatsApp (LMS template process API)
# Template: account_creation_confirmation_3 — Hi {{1}}, account created...
WHATSAPP_ACCOUNT_TEMPLATE_ENABLED=true
WHATSAPP_ACCOUNT_TEMPLATE_URL=https://adminapis.backendprod.com/lms_campaign/api/whatsapp/template/qrjmb8o062/process
# Optional override; defaults to WHATSAPP_API_KEY
# WHATSAPP_ACCOUNT_TEMPLATE_API_KEY=
# receiver: e164 (91XXXXXXXXXX) or national (10-digit)
WHATSAPP_ACCOUNT_RECEIVER_FORMAT=e164
